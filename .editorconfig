# EditorConfig helps developers define and maintain consistent
# coding styles between different editors and IDEs
# See also http://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

# Vendored third-party files: keep their bytes as published.
[tests/fixtures/{real-world-extras,real-world-locks}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[tests/fixtures/license-texts/*-LICENSE]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[tests/fixtures/{spdx-model,conformance}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
